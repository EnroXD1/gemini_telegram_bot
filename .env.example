# Обязательные секреты. Никогда не публикуйте заполненный .env.
TELEGRAM_BOT_TOKEN=123456789:replace_with_token_from_BotFather

# google — прямой Google API; openrouter — шлюз; groq — прямой текстовый Groq API.
AI_PROVIDER=google
GEMINI_API_KEY=replace_with_key_from_Google_AI_Studio
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash
# Бесплатные модели перебираются слева направо; пустое значение отключает список.
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free,nvidia/nemotron-3.5-lightning:free,openrouter/free
# Ограниченная локальная память OpenRouter: 6 последних обменов, до 16 000 символов.
OPENROUTER_HISTORY_TURNS=6
OPENROUTER_HISTORY_ITEM_CHARS=4000
OPENROUTER_HISTORY_MAX_CHARS=16000
OPENROUTER_HISTORY_RETENTION_DAYS=30

# Бесплатный текстовый участник общей резервной цепочки и отдельный провайдер.
# Если GROQ_API_KEY задан, Groq включается в автопереключение; AI_PROVIDER=groq
# делает его основной моделью уже при запуске.
GROQ_API_KEY=
GROQ_FALLBACK_ENABLED=true
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile
GROQ_MAX_OUTPUT_TOKENS=1024

# Модель и поведение Gemini.
# true для ключей Vertex AI Express Mode (в том числе с префиксом AQ.).
GEMINI_VERTEX_AI=false
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=4096
# Число автоматических продолжений, если модель остановилась по лимиту токенов.
# 0 отключает функцию; допустимый диапазон 0–5.
AI_MAX_CONTINUATIONS=2
# При лимите выбранной модели пробовать остальные настроенные API и модели.
AI_AUTO_FALLBACK_ENABLED=true
# Не проверять модель с исчерпанной квотой повторно в течение 10 минут.
AI_FALLBACK_COOLDOWN_SECONDS=600
GEMINI_STORE_INTERACTIONS=true
# GEMINI_SYSTEM_PROMPT=Собственная системная инструкция в одну строку

# mentions: /ask, @упоминание или reply; all: все сообщения; off: только /ask.
GROUP_DEFAULT_MODE=mentions
# chat_thread — общий контекст чата/темы; chat_thread_user — отдельный для каждого автора.
CONVERSATION_SCOPE=chat_thread

# Числовые Telegram ID через запятую. Только OWNER_IDS видят /users, /stats и /model.
# Username не используется для авторизации: его можно изменить.
OWNER_IDS=
# Пусто — разрешены все чаты. Иначе укажите ID личных чатов/групп через запятую.
ALLOWED_CHAT_IDS=

DATABASE_PATH=data/bot.sqlite3

# Мониторинг диалогов подключённого Telegram Business-аккаунта.
BUSINESS_MONITOR_ENABLED=true
# Глобальное значение по умолчанию. Владелец может изменить его командой
# /autoreply on|off в личном чате с ботом; выбор сохраняется в SQLite.
BUSINESS_AUTO_REPLY_ENABLED=true
# Сразу и без сообщений скачивать входящие фото, видео, GIF, аудио, голосовые,
# кружки и документы. Копия отправляется после удаления оригинала или явного
# ответа владельца на таймерное медиа до его открытия.
BUSINESS_ARCHIVE_MEDIA=true
BUSINESS_ARCHIVE_MAX_BYTES=20971520
# Сколько дней хранить локальные снимки текста и тихий архив медиа.
BUSINESS_MESSAGE_RETENTION_DAYS=30
# Один раз предупредить каждого нового Business-собеседника об автоответчике.
BUSINESS_WELCOME_ENABLED=true
# BUSINESS_WELCOME_TEXT=Здравствуйте! Вам отвечает автоматический помощник. /help — возможности.

MAX_MEDIA_BYTES=8388608
MAX_MEDIA_ITEMS=10
MAX_TEXT_FILE_CHARS=100000
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=45
MAX_CONCURRENT_REQUESTS=4
GEMINI_TIMEOUT_SECONDS=180
GEMINI_RETRY_ATTEMPTS=3
RATE_LIMIT_REQUESTS=8
RATE_LIMIT_WINDOW_SECONDS=60
# После трёх попыток обойти rate limit заблокировать AI-запросы пользователя на 5 минут.
SPAM_VIOLATION_LIMIT=3
SPAM_BLOCK_SECONDS=300
ALBUM_DEBOUNCE_SECONDS=0.8
REPLY_CHUNK_SIZE=4000
DROP_PENDING_UPDATES=false
LOG_LEVEL=INFO
